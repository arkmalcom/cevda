{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cevda-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cevda-assessments",
      "database_id": "e552b7f8-59d0-4db3-b8cd-be568a415125",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["centrovilladeangeles@gmail.com"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://cevda.com.do,https://www.cevda.com.do,https://cevda-web.cevda.workers.dev,http://localhost:5173",
    "SENDER_EMAIL": "formularios@cevda.com.do",
    "RECIPIENT_EMAIL": "centrovilladeangeles@gmail.com",
    "ATTEMPT_EXPIRATION_SECONDS": "900",
    "QUESTIONS_CATEGORY_COUNT": "5"
  }
  // Secrets (set with `wrangler secret put`): TURNSTILE_SECRET_KEY
}
